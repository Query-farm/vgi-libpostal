# name: test/sql/composed.test
# description: composed example queries (vgi_libpostal/meta.py COMPOSED_*) combining several postal objects
# group: [vgi_libpostal]

require-env VGI_LIBPOSTAL_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'postal' AS postal (TYPE vgi, LOCATION '{VGI_LIBPOSTAL_WORKER}');

# COMPOSED_DEDUP_EXAMPLE: address_postcode blocking + expand_address overlap.
query IIT
WITH customers(id, addr) AS (VALUES (1, '120 E 96th St, New York, NY 10128'), (2, '120 East 96th Street, New York NY 10128'), (3, '781 Franklin Ave, Brooklyn, NY 11216'), (4, '781 Franklin Avenue, Brooklyn NY 11216'), (5, '130 E 96th St, New York, NY 10128')), keyed AS (SELECT id, addr, postal.main.address_postcode(addr) AS postcode, postal.main.expand_address(addr) AS forms FROM customers) SELECT a.id AS id_a, b.id AS id_b, a.postcode FROM keyed AS a JOIN keyed AS b ON a.postcode = b.postcode AND a.id < b.id AND list_has_any(a.forms, b.forms) ORDER BY id_a, id_b
----
1	2	10128
3	4	11216

# COMPOSED_NORMALIZE_COMPONENTS_EXAMPLE: parse_address_components rows fed to expand_address.
query TTT
SELECT label, value, postal.main.expand_address(value) AS normalized FROM postal.main.parse_address_components('1600 Pennsylvania Ave NW, Washington, DC 20500') ORDER BY label
----
city	washington	[washington]
house_number	1600	[1600]
postcode	20500	[20500]
road	pennsylvania ave nw	[pennsylvania avenue northwest, pennsylvania avenue nw]
state	dc	[district of columbia, dc]

# COMPOSED_LABEL_COVERAGE_EXAMPLE: address_labels LEFT JOIN parse_address keys.
query TI
WITH addrs(addr) AS (VALUES ('781 Franklin Ave, Brooklyn, NY 11216'), ('Apt 5B, 120 E 96th St, New York, NY 10128'), ('10 Downing St, London SW1A 2AA, United Kingdom')), found AS (SELECT DISTINCT addr, unnest(map_keys(postal.main.parse_address(addr))) AS label FROM addrs) SELECT l.label, count(f.addr) AS addresses_with_label FROM postal.main.address_labels AS l LEFT JOIN found AS f USING (label) GROUP BY l.label ORDER BY addresses_with_label DESC, l.label
----
house_number	3
postcode	3
road	3
city	2
state	2
city_district	1
country	1
unit	1
category	0
country_region	0
entrance	0
house	0
island	0
level	0
near	0
po_box	0
staircase	0
state_district	0
suburb	0
world_region	0

# Agent-task graders (vgi-agent-tests.yaml): expected answers 2 and 14.
query I
WITH a(id, addr) AS (VALUES (1, '350 5th Ave, New York, NY 10118'), (2, '350 Fifth Avenue, New York NY 10118'), (3, '1600 Pennsylvania Ave NW, Washington, DC 20500'), (4, '1600 Pennsylvania Avenue Northwest, Washington DC 20500'), (5, '1650 Pennsylvania Ave NW, Washington, DC 20500'), (6, '10 Downing St, London SW1A 2AA')), k AS (SELECT id, postal.main.expand_address(addr) AS forms FROM a) SELECT count(*) FROM k AS x JOIN k AS y ON x.id < y.id AND list_has_any(x.forms, y.forms)
----
2

query I
SELECT count(*) FROM postal.main.address_labels WHERE label NOT IN (SELECT unnest(map_keys(postal.main.parse_address(addr))) FROM (VALUES ('1600 Pennsylvania Ave NW, Washington, DC 20500'), ('350 Fifth Avenue, New York NY 10118'), ('Apt 5B, 120 E 96th St, New York, NY 10128')) AS t(addr))
----
14
